# Postgres (docker-compose.yml)
DATABASE_URL=postgres://jarvis:jarvis_dev_local@localhost:5432/jarvis

# Redis (docker-compose.yml)
REDIS_URL=redis://localhost:6379

# LLM provider para la rama AGENT (ver plan, seccion Contexto).
# claude        -> usa CLAUDE_CODE_OAUTH_TOKEN (cuota Pro/Max, via `claude setup-token`)
# anthropic-api -> usa ANTHROPIC_API_KEY (pago por token)
LLM_PROVIDER=claude
