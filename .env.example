# Postgres (docker-compose.yml)
DATABASE_URL=postgres://jarvis:jarvis_dev_local@localhost:5432/jarvis

# Redis (docker-compose.yml)
REDIS_URL=redis://localhost:6379

# LLM provider para la rama AGENT (ver plan, seccion Contexto).
# claude        -> usa CLAUDE_CODE_OAUTH_TOKEN (cuota Pro/Max, via `claude setup-token`)
# anthropic-api -> usa ANTHROPIC_API_KEY (pago por token)
LLM_PROVIDER=claude

# GitHub MCP (opcional) - fine-grained PAT, scope Contents/Issues/Pull requests
GITHUB_PERSONAL_ACCESS_TOKEN=

# Telegram adapter (V3) - token de @BotFather
TELEGRAM_BOT_TOKEN=

# LLM barato para el router (V4) - ramas DIRECT/KNOWLEDGE, $0, no toca cuota Claude.
# Sin esto el router sigue funcionando: DIRECT sigue sin LLM, KNOWLEDGE cae a AGENT.
# Conseguir key gratis en https://console.groq.com/keys
CHEAP_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
