# Copiar a .env.prod en el VPS (nunca commitear). chmod 600.

POSTGRES_PASSWORD=cambiar-esto-por-algo-random

# Dentro de la red de Docker Compose los servicios se resuelven por nombre.
DATABASE_URL=postgres://robin:cambiar-esto-por-algo-random@postgres:5432/robin
REDIS_URL=redis://redis:6379

# Auth de Claude para la rama AGENT. Generar en el VPS con:
#   claude setup-token
# (flujo OAuth por navegador — abrís la URL que imprime en cualquier
# dispositivo, autorizás, y te devuelve el token para pegar acá). Ligado a tu
# suscripción Pro/Max, no a facturación por token — ver plan, sección Contexto.
LLM_PROVIDER=claude
CLAUDE_CODE_OAUTH_TOKEN=

# Si en algún momento se migra a facturación por token en vez de la suscripción:
# LLM_PROVIDER=anthropic-api
# ANTHROPIC_API_KEY=

GITHUB_PERSONAL_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=

# LLM barato para el router (V4) - ramas DIRECT/KNOWLEDGE, $0, no toca cuota Claude.
# Sin esto el router sigue funcionando: DIRECT sigue sin LLM, KNOWLEDGE cae a AGENT.
# Conseguir key gratis en https://console.groq.com/keys
CHEAP_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# STT (V6) - servicio whisper (docker-compose.prod.yml), resuelto por nombre
# dentro de la red interna. Vacío = notas de voz deshabilitadas.
WHISPER_URL=http://whisper:8000

# TTS (V6) - servicio piper (docker-compose.prod.yml). Vacío = Robin no
# manda nota de voz de vuelta (solo texto).
PIPER_URL=http://piper:8000

# Web UI (V7) - puerto interno del servicio `web` (Traefik lo publica en
# robin.rvaldiviase.com, protegido por el middleware tinyauth).
WEB_UI_PORT=3000

# Web Push (V7) - notificaciones reales al navegador para recordatorios del
# canal 'web' (antes solo polling). Vacío = deshabilitado. Generar con:
#   npx web-push generate-vapid-keys
# (mismo valor en `robin` y `web` - ambos servicios leen este mismo archivo).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cambiar-por-tu-email@ejemplo.com
